{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrat M01 de simulation LN-IA",
  "type": "object",
  "required": [
    "id",
    "title",
    "goal",
    "owner",
    "acceptance",
    "permissions",
    "maxSteps",
    "maxActions",
    "humanApproval"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "lire_sources",
          "rediger_brouillon"
        ]
      }
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "maxActions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "humanApproval": {
      "const": true
    }
  },
  "additionalProperties": true
}