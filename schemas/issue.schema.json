{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anomalie de production LN-IA",
  "type": "object",
  "required": [
    "id",
    "mission",
    "stage",
    "severity",
    "evidence",
    "owner",
    "status",
    "closure"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "closure": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "bloquante",
        "majeure",
        "mineure"
      ]
    },
    "status": {
      "enum": [
        "ouverte",
        "en-correction",
        "a-reverifier",
        "fermee"
      ]
    }
  }
}